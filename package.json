{
  "name": "dsh-claude-memory-reader",
  "version": "0.1.3",
  "type": "module",
  "description": "Read-only recall of Claude Code / Claude Code Desktop project Auto Memory inside DeepSeek Harness",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "claude-code",
    "auto-memory",
    "read-only"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "dsh": "0.2.1-rc.5"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:js && npm run lint:markdown",
    "lint:js": "eslint .",
    "lint:markdown": "markdownlint-cli2",
    "test": "node --test test/*.test.js",
    "check": "npm run format:check && npm run lint && npm run test:native && npm run verify:package",
    "test:native": "node scripts/test-native.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-format-v3-to-v4": "0.2.1-rc.5",
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.5",
    "semver": "7.7.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paigeman/dsh-claude-memory.git"
  },
  "homepage": "https://github.com/paigeman/dsh-claude-memory#readme",
  "bugs": {
    "url": "https://github.com/paigeman/dsh-claude-memory/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
